<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InterviewMasterApp</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InterviewMaster.Domain\InterviewMaster.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Application\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Interfaces\**\*.cs" />
    <Compile Include="AppNotifications.cs" />
  </ItemGroup>
</Project>
