<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>InterviewMasterApp</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InterviewMaster.Domain\InterviewMaster.Domain.csproj" />
    <ProjectReference Include="..\InterviewMaster.Application\InterviewMaster.Application.csproj" />
    <ProjectReference Include="..\InterviewMaster.Infrastructure\InterviewMaster.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="App.xaml.cs" />
    <Page Include="..\..\Presentation\Windows\MainWindow.xaml" Link="Presentation\Windows\MainWindow.xaml" />
    <Compile Include="..\..\Presentation\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
    <None Include="..\..\Models\silero-vad-onnx\silero_vad.onnx" Link="Models\silero-vad-onnx\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Models\silero-vad-onnx\silero_vad.onnx')" />
    <None Include="..\..\Resources\qa_database.json" Link="Resources\qa_database.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Resources\qa_database.json')" />
    <None Include="..\..\Resources\practice\**\*.json" Link="Resources\practice\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\icon_1024.png" Link="Resources\icon_1024.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\icon_1024.png')" />
  </ItemGroup>
</Project>
