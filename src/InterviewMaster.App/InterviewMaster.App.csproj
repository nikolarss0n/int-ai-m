    <Compile Include="..\..\Presentation\NotesEditor.cs" Link="NotesEditor.cs" />
    <Compile Include="..\..\Presentation\TemplateSelector.cs" Link="TemplateSelector.cs" />
    <!-- Settings -->
    <Compile Include="..\..\Presentation\Settings\SettingsWindowController.cs" Link="Settings\SettingsWindowController.cs" />
    <!-- Components -->
    <Compile Include="..\..\Presentation\Components\HoverButton.cs" Link="Components\HoverButton.cs" />
    <Compile Include="..\..\Presentation\Components\ScrollCaptureView.cs" Link="Components\ScrollCaptureView.cs" />
    <!-- Timeline -->
    <Compile Include="..\..\Presentation\Timeline\MessageViewFactory.cs" Link="Timeline\MessageViewFactory.cs" />
    <Compile Include="..\..\Presentation\Timeline\StreamingMessageHandler.cs" Link="Timeline\StreamingMessageHandler.cs" />
