    <Compile Include="..\..\Presentation\Styling\MarkdownRenderer.cs" Link="Styling\MarkdownRenderer.cs" />
    <Compile Include="..\..\Presentation\Styling\SyntaxHighlighter.cs" Link="Styling\SyntaxHighlighter.cs" />
    <Compile Include="..\..\Presentation\Styling\TextStyling.cs" Link="Styling\TextStyling.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\Models\silero-vad-onnx\silero_vad.onnx" Link="Models\silero-vad-onnx\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Models\silero-vad-onnx\silero_vad.onnx')" />
  </ItemGroup>
