    <Compile Include="..\..\Presentation\Windows\ScreenshotAlertWindow.cs" Link="Windows\ScreenshotAlertWindow.cs" />
    <Compile Include="..\..\Presentation\Windows\PermissionsPanelController.cs" Link="Windows\PermissionsPanelController.cs" />
    <Compile Include="..\..\Presentation\Windows\WindowFactory.cs" Link="Windows\WindowFactory.cs" />
    <!-- Controllers & Managers -->
    <Compile Include="..\..\Presentation\VoiceInterviewController.cs" Link="VoiceInterviewController.cs" />
    <Compile Include="..\..\Presentation\TimelineManager.cs" Link="TimelineManager.cs" />
    <Compile Include="..\..\Presentation\ScreenshotManager.cs" Link="ScreenshotManager.cs" />
    <Compile Include="..\..\Presentation\MenuBarSetup.cs" Link="MenuBarSetup.cs" />
    <Compile Include="..\..\Presentation\SearchController.cs" Link="SearchController.cs" />
    <Compile Include="..\..\Presentation\RecordingIndicator.cs" Link="RecordingIndicator.cs" />
    <Compile Include="..\..\Presentation\ScreenshotCaptureIndicator.cs" Link="ScreenshotCaptureIndicator.cs" />
    <Compile Include="..\..\Presentation\FormattingToolbar.cs" Link="FormattingToolbar.cs" />
    <Compile Include="..\..\Presentation\GhostMode.cs" Link="GhostMode.cs" />
    <Compile Include="..\..\Presentation\HotkeyManager.cs" Link="HotkeyManager.cs" />
    <Compile Include="..\..\Presentation\InterviewExport.cs" Link="InterviewExport.cs" />
