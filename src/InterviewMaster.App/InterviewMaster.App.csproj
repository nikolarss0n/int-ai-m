<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>InterviewMasterApp</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InterviewMaster.Domain\InterviewMaster.Domain.csproj" />
    <ProjectReference Include="..\InterviewMaster.Application\InterviewMaster.Application.csproj" />
    <ProjectReference Include="..\InterviewMaster.Infrastructure\InterviewMaster.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- App entry point -->
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="App.xaml.cs" />
    <!-- Main Window -->
    <Page Include="..\..\Presentation\Windows\MainWindow.xaml" Link="Presentation\Windows\MainWindow.xaml" />
    <Compile Include="..\..\Presentation\Windows\MainWindow.xaml.cs" Link="Presentation\Windows\MainWindow.xaml.cs" />
    <Compile Include="..\..\Presentation\Windows\MainWindowController.cs" Link="Windows\MainWindowController.cs" />
    <!-- Other Windows -->
