<Window x:Class="WindowsPresentationDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Presentation Demo" Height="500" Width="800">
    <Grid>
        <StackPanel Margin="12" Orientation="Vertical">
            <TextBlock Text="Windows Presentation Demo" FontSize="16" FontWeight="Bold" />
            <Button x:Name="ShowFloatingButton" Content="Show Floating Solution" Width="180" Click="ShowFloatingButton_Click" Margin="0,8,0,0" />
            <Button x:Name="ShowAlertButton" Content="Show Screenshot Alert" Width="180" Click="ShowAlertButton_Click" Margin="0,6,0,0" />
            <Button x:Name="ShowPermissionsButton" Content="Show Permissions Panel" Width="180" Click="ShowPermissionsButton_Click" Margin="0,6,0,0" />
            <Border x:Name="PermissionsHost" BorderThickness="1" BorderBrush="Gray" Margin="0,12,0,0" Height="260" />
        </StackPanel>
    </Grid>
</Window>
