<Window x:Class="InterviewMasterApp.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Master" Height="720" Width="1060"
        MinHeight="500" MinWidth="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border x:Name="OuterWindowBorder"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Background="#E6141418"
            ClipToBounds="True">
        <DockPanel x:Name="MainDockPanel">
            <!-- Custom Header Bar (icon, profile, inline notices, activity capsule, window controls) -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#FF1B1B1D" Height="42" Padding="14,0,6,0"
                    BorderBrush="#16FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: App Icon + Active Profile -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="HeaderAppIcon" Width="22" Height="22" Margin="0,0,10,0"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="ProfileHeaderLabel"
                                   Text="Interview Master"
                                   Foreground="#E6FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center: Inline Notice Slot -->
                    <ContentPresenter x:Name="NoticeHost"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      Margin="12,0,12,0" />

                    <!-- Right-center: Activity Capsule (Listening level meter / Transcribing / Muted) -->
                    <ContentPresenter x:Name="ActivityCapsuleHost"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      Margin="0,0,10,0" />

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Content="&#x2015;"
                                Width="38" Height="32"
                                Background="Transparent" Foreground="#B8FFFFFF"
                                BorderThickness="0" FontSize="12" Cursor="Hand" />
                        <Button x:Name="CloseButton" Content="&#x2715;"
                                Width="38" Height="32"
                                Background="Transparent" Foreground="#B8FFFFFF"
                                BorderThickness="0" FontSize="12" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unified Bottom Command Bar (wraps cleanly at 760px MinWidth) -->
            <Border DockPanel.Dock="Bottom"
                    Background="#FF1B1B1D"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="10,7">
                <DockPanel LastChildFill="True">
                    <!-- Left: Tab switcher -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="TabVoiceButton" Content="Live" Padding="10,5" Margin="0,0,3,0"
                                Background="#29CC45ED" Foreground="#FFEDADFF" FontWeight="SemiBold" FontSize="12"
                                BorderThickness="0" Cursor="Hand" ToolTip="Live Interview (Ctrl+1)" />
                        <Button x:Name="TabCodingButton" Content="Code" Padding="10,5" Margin="0,0,3,0"
                                Background="Transparent" Foreground="#B8FFFFFF" FontSize="12"
                                BorderThickness="0" Cursor="Hand" ToolTip="Code Panel (Ctrl+3)" />
                        <Button x:Name="TabNotesButton" Content="Notes" Padding="10,5" Margin="0,0,3,0"
                                Background="Transparent" Foreground="#B8FFFFFF" FontSize="12"
                                BorderThickness="0" Cursor="Hand" ToolTip="Notes &amp; CV (Ctrl+2)" />
                        <Button x:Name="TabPracticeButton" Content="Practice" Padding="10,5" Margin="0,0,4,0"
                                Background="Transparent" Foreground="#B8FFFFFF" FontSize="12"
                                BorderThickness="0" Cursor="Hand" ToolTip="Practice Decks (Ctrl+4)" />
                    </StackPanel>

                    <!-- Right: Wrapping controls + Start button so narrow windows never clip -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="VoiceStatusLabel"
                                   Text="Ready"
                                   Foreground="#B8FFFFFF"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="130"
                                   Margin="0,2,8,2" />
                        <ComboBox x:Name="AudioSourceCombo" Width="108" Height="27" Margin="0,2,5,2"
                                  FontSize="11" ToolTip="Audio capture source" />
                        <Button x:Name="MuteButton" Content="Mute" Padding="8,5" Margin="0,2,5,2"
                                Background="#FF26292F" Foreground="#D9FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Mute / Unmute (Ctrl+Shift+M)" />
                        <Button x:Name="ScreenshotButton" Content="Shot" Padding="8,5" Margin="0,2,4,2"
                                Background="#FF26292F" Foreground="#D9FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Capture Screenshot (Ctrl+Alt+S)" />
                        <Button x:Name="AnalyzeButton" Content="Analyze" Padding="8,5" Margin="0,2,4,2"
                                Background="#2459C7FA" Foreground="#FF9EE3FF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Analyze Screenshots (Ctrl+Alt+Enter)" />
                        <Button x:Name="ClearButton" Content="Clear" Padding="8,5" Margin="0,2,6,2"
                                Background="#FF26292F" Foreground="#B8FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Clear Screenshots / Code (Ctrl+Alt+G)" />
                        <Button x:Name="GhostModeButton" Content="Ghost" Padding="8,5" Margin="0,2,5,2"
                                Background="#FF26292F" Foreground="#B8FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Ghost Mode / Click-through (Ctrl+Alt+I)" />
                        <Slider x:Name="TransparencySlider" Width="56" Minimum="0" Maximum="0.85" Value="0.25"
                                VerticalAlignment="Center" Margin="2,2,6,2" ToolTip="Background transparency" />
                        <Button x:Name="ExportButton" Content="Export" Padding="8,5" Margin="0,2,4,2"
                                Background="#FF26292F" Foreground="#B8FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Export Interview (Ctrl+E)" />
                        <Button x:Name="SettingsButton" Content="Settings" Padding="8,5" Margin="0,2,6,2"
                                Background="#FF26292F" Foreground="#D9FFFFFF" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Settings (Ctrl+,)" />
                        <Button x:Name="StartInterviewButton" Content="▶ Start" Padding="12,5" Margin="0,2,0,2"
                                Background="#FF2D7D3A" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                BorderThickness="0" Cursor="Hand" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid x:Name="MainPanel">
                <!-- Live Interview Tab (Focus UI + hidden timeline fallback) -->
                <Grid x:Name="VoicePanel" Visibility="Visible">
                    <ContentPresenter x:Name="FocusViewHost" />
                    <ScrollViewer x:Name="VoiceTimelineScrollViewer" Visibility="Collapsed">
                        <StackPanel x:Name="VoiceTimelinePanel" />
                    </ScrollViewer>
                    <StackPanel x:Name="TypingDotsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,16" Visibility="Hidden" />
                </Grid>

                <!-- Code Panel Tab (Screenshot strip + Full-Width CodePanelView) -->
                <Grid x:Name="CodingPanel" Visibility="Collapsed" Margin="16,8,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ScreenshotStripScroll" Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel x:Name="ScreenshotThumbnailsPanel" Orientation="Horizontal" />
                    </ScrollViewer>

                    <ContentPresenter x:Name="CodePanelHost" Grid.Row="1" />
                    <RichTextBox x:Name="AnalysisRichTextBox" Visibility="Collapsed" IsReadOnly="True" />
                </Grid>

                <!-- Notes & CV Tab -->
                <Grid x:Name="NotesPanel" Visibility="Collapsed" Margin="16,8,16,8">
                    <Border Background="#FF1B1B1D" CornerRadius="16" BorderBrush="#16FFFFFF" BorderThickness="1">
                        <RichTextBox x:Name="NotesRichTextBox"
                                     Background="Transparent"
                                     Foreground="#E6FFFFFF"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     Padding="20"
                                     FontSize="15"
                                     FontFamily="Segoe UI"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <!-- Practice Tab -->
                <Grid x:Name="PracticePanel" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
