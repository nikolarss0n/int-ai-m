<Window x:Class="InterviewMasterApp.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Master" Height="720" Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Outer border gives the window a visible edge -->
    <Border BorderBrush="#FF555555" BorderThickness="1" Background="#FF28282D">
        <DockPanel x:Name="MainDockPanel">
            <!-- Custom Title Bar (drag to move window) -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#FF1C1C1E" Height="32">
                <Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="#FFAAAAAA"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="13"
                               IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton" Content="&#x2015;"
                                Width="46" Height="32"
                                Background="Transparent" Foreground="#FFAAAAAA"
                                BorderThickness="0" FontSize="13"
                                Cursor="Hand" />
                        <Button x:Name="CloseButton" Content="&#x2715;"
                                Width="46" Height="32"
                                Background="Transparent" Foreground="#FFAAAAAA"
                                BorderThickness="0" FontSize="13"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Bar at bottom -->
            <StatusBar DockPanel.Dock="Bottom" Background="#FF28282D">
                <StatusBarItem>
                    <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="White" />
                </StatusBarItem>
            </StatusBar>

            <!-- Main content area -->
            <Grid x:Name="MainPanel">
                <!-- Notes Tab Content -->
                <Grid x:Name="NotesPanel" Visibility="Collapsed">
                    <RichTextBox x:Name="NotesRichTextBox"
                                 Background="#FF28282D"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="20"
                                 FontSize="16"
                                 FontFamily="Segoe UI"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" />
                </Grid>

                <!-- Voice Tab Content -->
                <Grid x:Name="VoicePanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Timeline ScrollViewer -->
                    <ScrollViewer x:Name="VoiceTimelineScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="VoiceTimelinePanel" />
                    </ScrollViewer>

                    <!-- Typing Dots Container -->
                    <StackPanel x:Name="TypingDotsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,80"
                                Visibility="Hidden" />

                    <!-- Bottom Toolbar -->
                    <Border Grid.Row="1"
                            Background="#FF1C1C1E"
                            BorderBrush="#FF3C3C3E"
                            BorderThickness="0,1,0,0"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="VoiceStatusLabel"
                                       Grid.Column="0"
                                       Text="Ready"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="10,0,20,0" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="StartInterviewButton"
                                        Content="▶ Start Interview"
                                        Width="130"
                                        Height="32"
                                        Margin="5,0"
                                        Background="#FF2D7D3A"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Coding Tab Content -->
                <Grid x:Name="CodingPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="60"
                                  Background="#FF1C1C1E">
                        <StackPanel x:Name="ScreenshotThumbnailsPanel"
                                    Orientation="Horizontal"
                                    Margin="10" />
                    </ScrollViewer>

                    <RichTextBox x:Name="AnalysisRichTextBox"
                                 Grid.Row="1"
                                 Background="#FF28282D"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="20"
                                 FontSize="14"
                                 FontFamily="Consolas"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
